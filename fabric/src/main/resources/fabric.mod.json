{
  "schemaVersion": 1,
  "id": "superfastmath",
  "version": "${version}",
  "name": "SuperFastMath",
  "description": "This mod uses precomputed sin and cos via a table and sets them dynamically, which makes math way faster.",
  "authors": [
    "Elias"
  ],
  "contributors": [
    "404"
  ],
  "contact": {
    "homepage": "https://github.com/ItzjustElias/FastMathMod/",
    "sources": "https://github.com/ItzjustElias/FastMathMod/"
  },
  "license": "MIT",
  "icon": "assets/superfastmath/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.elias.fastmath.SuperFastMath"
    ],
    "client": [
    ]
  },
  "mixins": [
    "superfastmath.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${fabric_game_version_range}",
    "java": ">=${java_version}"
